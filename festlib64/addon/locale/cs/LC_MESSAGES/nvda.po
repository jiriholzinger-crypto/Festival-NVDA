msgid "included"
msgstr "součástí doplňku"

msgid "installed"
msgstr "nainstalováno"

msgid "Loading the voice list from festvox.org..."
msgstr "Načítám seznam hlasů z festvox.org..."

msgid "Cannot load the voice list: {error}"
msgstr "Seznam hlasů nelze načíst: {error}"

msgid "{count} voices available."
msgstr "Dostupných hlasů: {count}."

msgid "Downloading {name}"
msgstr "Stahování {name}"

msgid "Downloading {name}..."
msgstr "Stahuji {name}..."

msgid "{done:.1f} of {total:.1f} MB"
msgstr "{done:.1f} z {total:.1f} MB"

msgid "Unpacking..."
msgstr "Rozbaluji..."

msgid "Installation failed: {error}"
msgstr "Instalace selhala: {error}"

