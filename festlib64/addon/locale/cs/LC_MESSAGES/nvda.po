msgstr "Nainstalováno: {names}"

msgid "This voice needs the OALD pronunciation dictionary. Its licence allows non-commercial use only. Download it now?"
msgstr "Tento hlas potřebuje výslovnostní slovník OALD. Jeho licence povoluje jen nekomerční použití. Stáhnout ho nyní?"

msgid "This voice needs the {name} dictionary. Download it now?"
msgstr "Tento hlas potřebuje slovník {name}. Stáhnout ho nyní?"

msgid "Choose the new voice in NVDA's voice settings (NVDA+Control+V)."
msgstr "Nový hlas vyberte v nastavení hlasu NVDA (NVDA+Ctrl+V)."

msgid "Select Festival as the synthesizer to use the new voice."
msgstr "Pro použití nového hlasu vyberte syntezátor Festival."

msgid "Remove the voice {name}?"
msgstr "Odebrat hlas {name}?"

msgid "Removed: {name}"
msgstr "Odebráno: {name}"

msgid "Cannot remove the voice: {error}"
msgstr "Hlas nelze odebrat: {error}"

msgid "Please wait until the download is finished, or cancel it."
msgstr "Počkejte prosím na dokončení stahování, nebo ho zrušte."

msgid "American English, male (diphone)"
msgstr "americká angličtina, muž (difonový)"

